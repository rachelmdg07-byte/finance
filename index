        <div class="field-group"><div class="field-label">Nombre del ítem</div><input class="text-input" type="text" id="w-nombre" placeholder="Ej: Tenis Nike, AirPods..."></div>
        <div class="form-row">
          <div><div class="field-label">Precio aprox.</div><div class="monto-wrap"><span class="currency" style="font-size:14px">L</span><input class="monto-input monto-sm" type="number" id="w-precio" placeholder="0" inputmode="decimal"></div></div>
          <div><div class="field-label">Categoría</div><input class="text-input" type="text" id="w-cat" placeholder="Ropa, Tech..."></div>
        </div>
        <div class="field-group"><div class="field-label">Prioridad</div>
          <div class="pri-toggle">
            <button class="pri-btn on-alta" id="pri-alta" onclick="setPri('alta')">🔴 Alta</button>
            <button class="pri-btn" id="pri-media" onclick="setPri('media')">🟡 Media</button>
            <button class="pri-btn" id="pri-baja" onclick="setPri('baja')">🟢 Baja</button>
          </div>
        </div>
        <div class="field-group"><div class="field-label">Nota / Link</div><input class="text-input" type="text" id="w-nota" placeholder="Nota o URL del producto..."></div>
        <button class="save-btn pur" onclick="crearWish()">Agregar a la lista</button>
      </div>

      <div class="wish-filter" id="wish-filter"></div>
      <div class="wish-sort">
        <span>Ordenar:</span>
        <button class="sort-btn active" id="sort-fecha" onclick="setSort('fecha')">Reciente</button>
        <button class="sort-btn" id="sort-precio" onclick="setSort('precio')">Precio</button>
        <button class="sort-btn" id="sort-pri" onclick="setSort('pri')">Prioridad</button>
      </div>
      <div id="wish-list"></div>
    </div>
  </div>

  <!-- HISTORY -->
  <div class="screen page" id="page-hist">
    <div class="hist-top">
      <div class="top-bar" style="padding:0 0 12px"><h1>🗂 Historial</h1></div>
      <div class="filter-row" id="hist-filters"></div>
    </div>
    <div style="padding:0 20px"><div class="tx-list" id="hist-list"></div></div>
  </div>

  <!-- NAV -->
  <nav class="nav">
    <button class="nav-btn active" onclick="goPage('dash',this)"><span class="nav-icon">◈</span><span>Resumen</span></button>
    <button class="nav-btn" onclick="goPage('form',this)"><span class="nav-icon">⊕</span><span>Registrar</span></button>
    <button class="nav-btn" onclick="goPage('metas',this)"><span class="nav-icon">🎯</span><span>Metas</span></button>
    <button class="nav-btn" onclick="goPage('wish',this)"><span class="nav-icon">🛍</span><span>Wish List</span></button>
    <button class="nav-btn" onclick="goPage('hist',this)"><span class="nav-icon">≡</span><span>Historial</span></button>
  </nav>
</div>

<!-- MODAL ABONAR -->
<div class="modal-bg" id="modal-bg" onclick="closeModal(event)">
  <div class="modal">
    <h3 id="modal-title">Abonar a meta</h3>
    <div class="field-group"><div class="field-label">Monto a abonar</div><div class="monto-wrap"><span class="currency">L</span><input class="monto-input" type="number" id="modal-monto" placeholder="0.00" inputmode="decimal" min="0"></div></div>
    <button class="save-btn blu" onclick="confirmarAbono()">Confirmar abono</button>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
const CATS={
  ingreso:[{k:'Salario',e:'💼'},{k:'Freelance',e:'🛠'},{k:'Inversión',e:'📈'},{k:'Regalo',e:'🎁'},{k:'Venta',e:'🏷'},{k:'Otro',e:'➕'}],
  egreso:[{k:'Comida',e:'🍽'},{k:'Transporte',e:'🚗'},{k:'Casa',e:'🏠'},{k:'Gym',e:'🏋'},{k:'Ocio',e:'🎉'},{k:'Educación',e:'📚'},{k:'Teléfono',e:'📱'},{k:'Ropa',e:'👕'},{k:'Salud',e:'❤️‍🩹'},{k:'Supermercado',e:'🛒'},{k:'Servicios',e:'💡'},{k:'Otro',e:'•••'}]
};
const META_EMOJIS=['🏖','✈️','💻','🚗','🏠','📱','🎓','💍','🏋','🎸','📷','🐶','🎮','👗','🛋','🌍','💰','🎯'];
const PRI_ORDER={alta:0,media:1,baja:2};

let tipo='ingreso',cat='',data=[],metas=[],wishes=[];
let metaActualId=null,metaEmojiSel='🎯',wishPriSel='alta';
let showMetaForm=false,showWishForm=false;
let histFilter='todos',wishFilterSel='todos',wishSort='fecha';

function save(){
  localStorage.setItem('finz_data',JSON.stringify(data));
  localStorage.setItem('finz_metas',JSON.stringify(metas));
  localStorage.setItem('finz_wishes',JSON.stringify(wishes));
}
function load(){
  try{data=JSON.parse(localStorage.getItem('finz_data')||'[]');}catch(e){data=[];}
  try{metas=JSON.parse(localStorage.getItem('finz_metas')||'[]');}catch(e){metas=[];}
  try{wishes=JSON.parse(localStorage.getItem('finz_wishes')||'[]');}catch(e){wishes=[];}
}
function fmt(n){return n.toLocaleString('es-HN',{minimumFractionDigits:2,maximumFractionDigits:2});}
function fmtDate(iso){return new Date(iso).toLocaleDateString('es-HN',{day:'2-digit',month:'short'});}
function toast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2200);}

function goPage(id,btn){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.getElementById('page-'+id).classList.add('active');
  document.querySelectorAll('.nav-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  if(id==='dash')renderDash();
  if(id==='hist')renderHist();
  if(id==='metas')renderMetas();
  if(id==='wish')renderWish();
}

// FORM
function setTipo(t){
  tipo=t;cat='';
  document.getElementById('btn-ing').className='type-btn'+(t==='ingreso'?' on-ing':'');
  document.getElementById('btn-egr').className='type-btn'+(t==='egreso'?' on-egr':'');
  document.getElementById('save-btn').className='save-btn '+(t==='ingreso'?'ing':'egr');
  document.getElementById('save-btn').textContent='Guardar '+t;
  renderCats();
}
function renderCats(){
  document.getElementById('f-cats').innerHTML=CATS[tipo].map(c=>`
    <div class="cat-pill${cat===c.k?' sel':''}" onclick="selCat('${c.k}',this)">
      <span class="emoji">${c.e}</span><span class="name">${c.k}</span>
    </div>`).join('');
}
function selCat(k,el){cat=k;document.querySelectorAll('.cat-pill').forEach(p=>p.classList.remove('sel'));el.classList.add('sel');}
function guardar(){
  const monto=parseFloat(document.getElementById('f-monto').value);
  const desc=document.getElementById('f-desc').value.trim();
  if(!monto||monto<=0){toast('Ingresa un monto válido');return;}
  if(!cat){toast('Selecciona una categoría');return;}
  data.unshift({id:Date.now(),tipo,cat,monto,desc,fecha:new Date().toISOString()});
  if(data.length>1000)data=data.slice(0,1000);
  save();
  toast(tipo==='ingreso'?'✓ Ingreso guardado':'✓ Gasto guardado');
  document.getElementById('f-monto').value='';
  document.getElementById('f-desc').value='';
  cat='';renderCats();
}

// DASHBOARD
function renderDash(){
  const ing=data.filter(e=>e.tipo==='ingreso');
  const egr=data.filter(e=>e.tipo==='egreso');
  const sumIng=ing.reduce((s,e)=>s+e.monto,0),sumEgr=egr.reduce((s,e)=>s+e.monto,0),balance=sumIng-sumEgr;
  const el=document.getElementById('d-balance');
  el.textContent='L '+fmt(Math.abs(balance));
  el.className='balance-amount '+(balance>=0?'pos':'neg');
  document.getElementById('d-ing').textContent='L '+fmt(sumIng);
  document.getElementById('d-egr').textContent='L '+fmt(sumEgr);
  document.getElementById('d-ing-n').textContent=ing.length+' entradas';
  document.getElementById('d-egr-n').textContent=egr.length+' entradas';

  const months={};
  data.forEach(e=>{
    const d=new Date(e.fecha),k=d.getFullYear()+'-'+(d.getMonth()+1).toString().padStart(2,'0'),label=d.toLocaleDateString('es-HN',{month:'short'});
    if(!months[k])months[k]={label,ing:0,egr:0};
    if(e.tipo==='ingreso')months[k].ing+=e.monto;else months[k].egr+=e.monto;
  });
  const mKeys=Object.keys(months).sort().slice(-6),maxM=Math.max(...mKeys.map(k=>Math.max(months[k].ing,months[k].egr)),1);
  document.getElementById('d-months').innerHTML=mKeys.length?mKeys.map(k=>{
    const m=months[k],ih=Math.round((m.ing/maxM)*68),eh=Math.round((m.egr/maxM)*68);
    return `<div class="month-col"><div class="month-bars"><div class="month-bar ing" style="height:${Math.max(ih,2)}px"></div><div class="month-bar egr" style="height:${Math.max(eh,2)}px"></div></div><div class="month-label">${m.label}</div></div>`;
  }).join(''):'<div style="color:var(--muted);font-size:12px">Sin datos aún</div>';

  const catT={};
  egr.forEach(e=>{catT[e.cat]=(catT[e.cat]||0)+e.monto;});
  const topCats=Object.entries(catT).sort((a,b)=>b[1]-a[1]).slice(0,5),maxC=topCats[0]?.[1]||1;
  document.getElementById('d-cats').innerHTML=topCats.length?topCats.map(([c,v])=>`
    <div class="bar-row"><div class="bar-cat">${c}</div><div class="bar-track"><div class="bar-fill" style="width:${Math.round((v/maxC)*100)}%;background:var(--red)"></div></div><div class="bar-val">L${fmt(v)}</div></div>`).join(''):'<div style="color:var(--muted);font-size:12px">Sin egresos aún</div>';

  const activasMetas=metas.filter(m=>m.actual<m.objetivo).slice(0,2);
  document.getElementById('d-metas').innerHTML=activasMetas.length?activasMetas.map(m=>{
    const pct=Math.min(100,Math.round((m.actual/m.objetivo)*100));
    return `<div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:12px;margin-bottom:8px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
        <span style="font-size:14px;font-weight:600">${m.emoji} ${m.nombre}</span>
        <span style="font-family:var(--mono);font-size:12px;color:var(--accent)">${pct}%</span>
      </div>
      <div class="meta-track"><div class="meta-fill" style="width:${pct}%"></div></div>
      <div style="font-family:var(--mono);font-size:11px;color:var(--muted)">L${fmt(m.actual)} / L${fmt(m.objetivo)}</div>
    </div>`;
  }).join(''):'<div style="color:var(--muted);font-size:12px;padding:4px 0">Sin metas activas</div>';

  // Wish list dashboard mini
  const pendientes=wishes.filter(w=>!w.comprado);
  const totalWish=pendientes.reduce((s,w)=>s+(w.precio||0),0);
  document.getElementById('d-wish').innerHTML=pendientes.length?`
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:12px;margin-bottom:8px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
        <span style="font-size:13px;font-weight:600;color:var(--muted)">${pendientes.length} ítems pendientes</span>
        <span style="font-family:var(--mono);font-size:12px;color:var(--purple)">L${fmt(totalWish)}</span>
      </div>
      ${pendientes.slice(0,3).map(w=>`
        <div style="display:flex;align-items:center;justify-content:space-between;padding:5px 0;border-bottom:1px solid var(--border)">
          <div style="display:flex;align-items:center;gap:6px">
            <span style="font-size:8px;color:${w.prioridad==='alta'?'var(--red)':w.prioridad==='media'?'var(--yellow)':'var(--green)'}">●</span>
            <span style="font-size:13px;color:var(--text)">${w.nombre}</span>
          </div>
          ${w.precio?`<span style="font-family:var(--mono);font-size:12px;color:var(--purple)">L${fmt(w.precio)}</span>`:''}
        </div>`).join('')}
    </div>`:'<div style="color:var(--muted);font-size:12px;padding:4px 0">Sin ítems pendientes</div>';

  const recent=data.slice(0,6);
  document.getElementById('d-recent').innerHTML=recent.length?recent.map(e=>`
    <div class="tx-item">
      <div class="tx-icon ${e.tipo==='ingreso'?'ing':'egr'}">${CATS[e.tipo].find(c=>c.k===e.cat)?.e||'•'}</div>
      <div class="tx-info"><div class="tx-cat">${e.cat}</div><div class="tx-desc">${e.desc||fmtDate(e.fecha)}</div></div>
      <div class="tx-right"><div class="tx-amt ${e.tipo==='ingreso'?'ing':'egr'}">${e.tipo==='ingreso'?'+':'-'}L${fmt(e.monto)}</div><div class="tx-date">${fmtDate(e.fecha)}</div></div>
    </div>`).join(''):'<div class="empty"><div class="big">📭</div><p>Aún no hay entradas.<br>Registra tu primera transacción.</p></div>';
}

// HISTORY
function renderHist(){
  const cats=['todos','ingreso','egreso',...new Set(data.map(e=>e.cat))];
  document.getElementById('hist-filters').innerHTML=cats.map(c=>`<div class="f-chip${histFilter===c?' active':''}" onclick="setHistFilter('${c}')">${c}</div>`).join('');
  const filtered=histFilter==='todos'?data:histFilter==='ingreso'||histFilter==='egreso'?data.filter(e=>e.tipo===histFilter):data.filter(e=>e.cat===histFilter);
  document.getElementById('hist-list').innerHTML=filtered.length?filtered.map(e=>`
    <div class="tx-item">
      <div class="tx-icon ${e.tipo==='ingreso'?'ing':'egr'}">${CATS[e.tipo].find(c=>c.k===e.cat)?.e||'•'}</div>
      <div class="tx-info"><div class="tx-cat">${e.cat}</div><div class="tx-desc">${e.desc||'—'} · ${fmtDate(e.fecha)}</div></div>
      <div class="tx-right"><div class="tx-amt ${e.tipo==='ingreso'?'ing':'egr'}">${e.tipo==='ingreso'?'+':'-'}L${fmt(e.monto)}</div></div>
      <button class="del-btn" onclick="borrar(${e.id})">🗑</button>
    </div>`).join(''):'<div class="empty"><div class="big">🔍</div><p>Sin resultados.</p></div>';
}
function setHistFilter(f){histFilter=f;renderHist();}
function borrar(id){data=data.filter(e=>e.id!==id);save();renderHist();toast('Entrada eliminada');}

// METAS
function toggleForm(type){
  if(type==='meta'){
    showMetaForm=!showMetaForm;
    document.getElementById('nueva-meta-form').style.display=showMetaForm?'block':'none';
    document.getElementById('toggle-meta-btn').textContent=showMetaForm?'✕ Cancelar':'+ Nueva meta';
  } else {
    showWishForm=!showWishForm;
    document.getElementById('nueva-wish-form').style.display=showWishForm?'block':'none';
    document.getElementById('toggle-wish-btn').textContent=showWishForm?'✕ Cancelar':'+ Agregar ítem';
  }
}
function renderMetaEmojiGrid(){
  document.getElementById('meta-emoji-grid').innerHTML=META_EMOJIS.map(e=>`<span class="emoji-opt${metaEmojiSel===e?' sel':''}" onclick="selMetaEmoji('${e}',this)">${e}</span>`).join('');
}
function selMetaEmoji(e,el){metaEmojiSel=e;document.querySelectorAll('#meta-emoji-grid .emoji-opt').forEach(x=>x.classList.remove('sel'));el.classList.add('sel');}
function crearMeta(){
  const nombre=document.getElementById('m-nombre').value.trim();
  const objetivo=parseFloat(document.getElementById('m-objetivo').value);
  const fecha=document.getElementById('m-fecha').value;
  const inicial=parseFloat(document.getElementById('m-inicial').value)||0;
  if(!nombre){toast('Ponle un nombre a tu meta');return;}
  if(!objetivo||objetivo<=0){toast('Ingresa el monto objetivo');return;}
  metas.unshift({id:Date.now(),emoji:metaEmojiSel,nombre,objetivo,actual:inicial,fecha,creada:new Date().toISOString()});
  save();
  document.getElementById('m-nombre').value='';
  document.getElementById('m-objetivo').value='';
  document.getElementById('m-fecha').value='';
  document.getElementById('m-inicial').value='';
  toggleForm('meta');renderMetas();toast('🎯 Meta creada!');
}
function renderMetas(){
  renderMetaEmojiGrid();
  if(!metas.length){document.getElementById('metas-list').innerHTML='<div class="empty"><div class="big">🎯</div><p>No tienes metas aún.</p></div>';return;}
  const hoy=new Date();
  document.getElementById('metas-list').innerHTML=metas.map(m=>{
    const pct=Math.min(100,Math.round((m.actual/m.objetivo)*100)),done=m.actual>=m.objetivo;
    let diasTxt='',diasClass='meta-days';
    if(m.fecha){
      const diff=Math.ceil((new Date(m.fecha)-hoy)/(1000*60*60*24));
      if(done){diasTxt='✓ Meta completada';diasClass='meta-days done-c';}
      else if(diff<0){diasTxt=`Venció hace ${Math.abs(diff)} días`;diasClass='meta-days vencida';}
      else if(diff<=7){diasTxt=`⚠️ ${diff} días restantes`;diasClass='meta-days urgente';}
      else{diasTxt=`${diff} días restantes`;}
    } else if(done){diasTxt='✓ Meta completada';diasClass='meta-days done-c';}
    return `<div class="meta-card">
      <div class="meta-header"><div><span class="meta-emoji">${m.emoji}</span><span class="meta-nombre">${m.nombre}</span></div><span class="meta-pct">${pct}%</span></div>
      ${diasTxt?`<div class="${diasClass}">${diasTxt}</div>`:''}
      <div class="meta-track"><div class="meta-fill${done?' done':''}" style="width:${pct}%"></div></div>
      <div class="meta-nums"><span>Ahorrado: <span class="hi">L${fmt(m.actual)}</span></span><span>Falta: <span class="hi">L${fmt(Math.max(0,m.objetivo-m.actual))}</span></span></div>
      <div class="meta-nums" style="margin-top:2px"><span>Objetivo: L${fmt(m.objetivo)}</span></div>
      <div class="meta-footer">
        ${!done?`<button class="abonar-btn" onclick="abrirAbono(${m.id})">+ Abonar</button>`:'<button class="abonar-btn" style="background:var(--green-dim);border-color:var(--green);color:var(--green)">🎉 Completada</button>'}
        <button class="meta-del-btn" onclick="borrarMeta(${m.id})">🗑</button>
      </div>
    </div>`;
  }).join('');
}
function borrarMeta(id){if(!confirm('¿Eliminar esta meta?'))return;metas=metas.filter(m=>m.id!==id);save();renderMetas();toast('Meta eliminada');}
function abrirAbono(id){
  metaActualId=id;
  const m=metas.find(m=>m.id===id);
  document.getElementById('modal-title').textContent='Abonar a: '+m.nombre;
  document.getElementById('modal-monto').value='';
  document.getElementById('modal-bg').classList.add('open');
  setTimeout(()=>document.getElementById('modal-monto').focus(),300);
}
function closeModal(e){if(e.target===document.getElementById('modal-bg'))document.getElementById('modal-bg').classList.remove('open');}
function confirmarAbono(){
  const monto=parseFloat(document.getElementById('modal-monto').value);
  if(!monto||monto<=0){toast('Ingresa un monto válido');return;}
  const m=metas.find(m=>m.id===metaActualId);if(!m)return;
  m.actual=Math.min(m.objetivo,m.actual+monto);save();
  document.getElementById('modal-bg').classList.remove('open');
  renderMetas();
  toast(m.actual>=m.objetivo?'🎉 ¡Meta completada!':'✓ Abono guardado · L'+fmt(monto));
}

// WISHLIST
function setPri(p){
  wishPriSel=p;
  ['alta','media','baja'].forEach(x=>{
    const btn=document.getElementById('pri-'+x);
    btn.className='pri-btn'+(x===p?' on-'+x:'');
  });
}
function crearWish(){
  const nombre=document.getElementById('w-nombre').value.trim();
  const precio=parseFloat(document.getElementById('w-precio').value)||0;
  const cat=document.getElementById('w-cat').value.trim();
  const nota=document.getElementById('w-nota').value.trim();
  if(!nombre){toast('Ponle un nombre al ítem');return;}
  wishes.unshift({id:Date.now(),nombre,precio,cat,nota,prioridad:wishPriSel,comprado:false,fecha:new Date().toISOString()});
  save();
  document.getElementById('w-nombre').value='';
  document.getElementById('w-precio').value='';
  document.getElementById('w-cat').value='';
  document.getElementById('w-nota').value='';
  wishPriSel='alta';setPri('alta');
  toggleForm('wish');renderWish();toast('🛍 Ítem agregado!');
}
function toggleComprado(id){
  const w=wishes.find(w=>w.id===id);if(!w)return;
  w.comprado=!w.comprado;
  if(w.comprado)w.fechaComprado=new Date().toISOString();else delete w.fechaComprado;
  save();renderWish();
  toast(w.comprado?'✓ ¡Marcado como comprado!':'↩ Movido a pendientes');
}
function borrarWish(id){wishes=wishes.filter(w=>w.id!==id);save();renderWish();toast('Ítem eliminado');}
function setWishFilter(f){wishFilterSel=f;renderWish();}
function setSort(s){wishSort=s;['fecha','precio','pri'].forEach(x=>{document.getElementById('sort-'+x).className='sort-btn'+(x===s?' active':'');});renderWish();}
function isURL(s){try{return s&&(s.startsWith('http')||s.startsWith('www'));} catch(e){return false;}}
function renderWish(){
  // Stats
  const pend=wishes.filter(w=>!w.comprado),comp=wishes.filter(w=>w.comprado);
  const totalPend=pend.reduce((s,w)=>s+(w.precio||0),0);
  document.getElementById('wish-stats').innerHTML=`
    <div class="wish-stat"><div class="ws-label">Pendientes</div><div class="ws-val pur">${pend.length} ítems</div><div style="font-family:var(--mono);font-size:12px;color:var(--muted);margin-top:3px">L${fmt(totalPend)}</div></div>
    <div class="wish-stat"><div class="ws-label">Comprados</div><div class="ws-val">${comp.length} ítems</div><div style="font-size:11px;color:var(--muted);margin-top:3px">de ${wishes.length} total</div></div>`;

  // Filter chips
  const cats=['todos',...new Set(wishes.map(w=>w.cat).filter(Boolean)),'comprados'];
  document.getElementById('wish-filter').innerHTML=cats.map(c=>`<div class="f-chip${wishFilterSel===c?' active':''}" onclick="setWishFilter('${c}')">${c}</div>`).join('');

  // Filter + sort
  let filtered=wishFilterSel==='todos'?[...wishes]:wishFilterSel==='comprados'?wishes.filter(w=>w.comprado):wishes.filter(w=>w.cat===wishFilterSel);
  if(wishSort==='precio')filtered.sort((a,b)=>(b.precio||0)-(a.precio||0));
  else if(wishSort==='pri')filtered.sort((a,b)=>PRI_ORDER[a.prioridad]-PRI_ORDER[b.prioridad]);

  if(!filtered.length){document.getElementById('wish-list').innerHTML='<div class="empty"><div class="big">🛍</div><p>Nada aquí aún.<br>Agrega tus ítems deseados.</p></div>';return;}

  document.getElementById('wish-list').innerHTML=filtered.map(w=>`
    <div class="wish-item${w.comprado?' comprado':''}">
      <div class="wish-check${w.comprado?' done':''}" onclick="toggleComprado(${w.id})"><span>✓</span></div>
      <div class="wish-body">
        <div>
          ${w.cat?`<span class="wish-cat-badge">${w.cat}</span>`:''}
          <span class="wish-pri ${w.prioridad}">${w.prioridad==='alta'?'🔴 Alta':w.prioridad==='media'?'🟡 Media':'🟢 Baja'}</span>
        </div>
        <div class="wish-nombre">${w.nombre}</div>
        ${w.precio?`<div class="wish-precio">L ${fmt(w.precio)}</div>`:'<div class="wish-precio sin-precio">Sin precio</div>'}
        ${w.nota&&!isURL(w.nota)?`<div class="wish-nota">${w.nota}</div>`:''}
        ${w.comprado&&w.fechaComprado?`<div style="font-size:10px;color:var(--green);margin-top:4px">Comprado el ${fmtDate(w.fechaComprado)}</div>`:''}
      </div>
      <div class="wish-actions">
        ${isURL(w.nota)?`<a class="wish-link" href="${w.nota.startsWith('http')?w.nota:'https://'+w.nota}" target="_blank">🔗</a>`:''}
        <button class="wish-del" onclick="borrarWish(${w.id})">🗑</button>
      </div>
    </div>`).join('');
}

// INIT
load();renderCats();renderDash();renderMetaEmojiGrid();setPri('alta');
</script>
</body>
</html>
